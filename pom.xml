            <artifactId>spring-boot-starter-logging</artifactId>
        </dependency>

        <!-- All Flink dependencies -->
        <!-- Flink - Scope provided means they are provided in the lib folder and
        added as module dependencies and thus not included in the package - if you
        do not want to use the external lib jars then rather comment out the scope line -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-java</artifactId>
            <version>${flink.version}</version>
            <!--<scope>provided</scope>-->
        </dependency>

